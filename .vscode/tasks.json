{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "uv: sync",
      "type": "shell",
      "command": "uv",
      "args": [
        "sync",
      ],
      "options": {"cwd": "${workspaceFolder}"},
    },
    {
      "label": "Python: build (Debug)",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python",
      "args": ["scripts\\build.py", "build", "Debug"],
      "dependsOn": "uv: sync",
    },
    {
      "label": "Python: build (Release)",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python",
      "args": ["scripts\\build.py", "build", "Release"],
      "dependsOn": "uv: sync",
    },
    { // This is visible from the CMakeTool extension in VS Code
      "label": "CMake: build (Debug)",
      "type": "cmake",
      "command": "build",
      "targets": ["ALL_BUILD"], // CMakeTool needs this for Visual Studio projects
      "preset": "conan-debug_dir-debug",
      "dependsOn": "Python: build (Debug)",
    },
    { // This is visible from the CMakeTool extension in VS Code
      "label": "CMake: build (Release)",
      "type": "cmake",
      "command": "build",
      "targets": ["ALL_BUILD"], // CMakeTool needs this
      "preset": "conan-release_dir-release",
      "dependsOn": "Python: build (Release)",
    },
    {
      "label": "CMake: deploy (Release)",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\cmake",
      "args": ["--build", "${workspaceFolder}\\build-Release", "--preset", "conan-release_dir-release", "--config", "Release", "--target", "deploy"],
      "dependsOn": "Python: build (Release)",
    },
    {
      "label": "Deploy (compress)",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python",
      "args": ["scripts\\build.py", "package", "Release"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": "build",
      "presentation": { "echo": true, "panel": "shared" },
      "dependsOn": "CMake: deploy (Release)",
      "problemMatcher": []
    },
  ]
}

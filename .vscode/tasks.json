{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "uv: sync",
      "type": "shell",
      "command": "uv",
      "args": [
        "sync",
      ],
      "options": {"cwd": "${workspaceFolder}"},
      "presentation": {
        "reveal": "silent",
        "echo": true,
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Python: build",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python",
      "args": ["scripts\\build.py", "build"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": { "kind": "build", "isDefault": true },
      "presentation": {
        "reveal": "silent",
        "echo": true,
        "panel": "shared"
      },
      "problemMatcher": [],
      "dependsOn": "uv: sync",
    },
    { // This is visible from the CMakeTool extension in VS Code
      // "label": "CMake: build conan (debug)",
      "label": "CMake: build (release)",
      "type": "cmake",
      "command": "build",
      // "preset": "conan-debug",
      "preset": "conan-release",
      "group": { "kind": "build", "isDefault": true },
      "presentation": {
        "reveal": "silent",
        "echo": true,
        "panel": "shared"
      },
      "problemMatcher": [],
      "dependsOn": "Python: build",
    },
    {
      "label": "CMake: deploy (Release)",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\cmake",
      "args": ["--build", "${workspaceFolder}\\build", "--preset", "conan-release", "--config", "Release", "--target", "deploy"],
      "group": "build",
      "presentation": {
        "echo": true,
        "panel": "shared"
      },
      "dependsOn": "CMake: build (release)",
      "problemMatcher": []
    },
    {
      "label": "Python: package deploy ZIP",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python",
      "args": ["scripts\\build.py", "package"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": "build",
      "presentation": { "echo": true, "panel": "shared" },
      "dependsOn": "CMake: deploy (Release)",
      "problemMatcher": []
    },
  ]
}
